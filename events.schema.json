                "owner": {
                  "type": "string"
                },
                "repo": {
                  "type": "string"
                },
                "event": {
                  "type": "string"
                },
                "deliveryId": {
                  "type": "string"
                },
                "hookId": {
                  "type": ["string", "null"]
                },
                "payload": {}
              },
              "required": [
                "schemaVersion",
                "receivedAt",
                "owner",
                "repo",
                "event",
                "deliveryId",
                "hookId",
                "payload"
              ],
              "additionalProperties": false
            }
          },
          "required": ["instanceId", "generation", "sequence", "emittedAt", "delivery"],
          "additionalProperties": false
        }
      },
      "required": ["v", "type", "event", "data"],
      "additionalProperties": false,
      "description": "Transient authenticated webhook delivery; no persistence, replay or snapshot recovery. Never discard using a CI watermark."
    }
  }
}
