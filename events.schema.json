            },
            "emittedAt": {
              "type": "string"
            },
            "inventory": {
              "type": "string",
              "enum": ["complete", "incomplete", "unavailable"]
            },
            "projection": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "schemaVersion": {
                      "type": "number",
                      "const": 3
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "projectedAt": {
                      "type": "string"
                    },
                    "owner": {
                      "type": "string"
                    },
                    "repo": {
                      "type": "string"
                    },
                    "paths": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "available": {
                      "type": "boolean"
                    },
                    "visibility": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": ["PRIVATE", "PUBLIC", "INTERNAL"]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "defaultBranch": {
                      "type": ["string", "null"]
                    },
                    "primaryBranch": {
                      "type": "string"
                    },
                    "heads": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "sha": {
                            "type": "string"
                          },
                          "committedAt": {
                            "type": ["string", "null"]
                          },
                          "aggregateState": {
                            "type": "string",
                            "enum": [
                              "ERROR",
                              "EXPECTED",
                              "FAILURE",
                              "PENDING",
                              "SUCCESS",
                              "NONE",
                              "LOCAL",
                              "UNAVAILABLE"
                            ]
                          },
                          "contexts": {
                            "type": "array",
                            "items": {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "check-run"
                                    },
                                    "name": {
                                      "type": "string"
                                    },
                                    "status": {
                                      "type": "string"
                                    },
                                    "conclusion": {
                                      "type": ["string", "null"]
                                    },
                                    "detailsUrl": {
                                      "type": ["string", "null"]
                                    },
                                    "app": {
                                      "type": ["string", "null"]
                                    },
                                    "startedAt": {
                                      "type": ["string", "null"]
                                    },
                                    "completedAt": {
                                      "type": ["string", "null"]
                                    }
                                  },
                                  "required": [
                                    "kind",
                                    "name",
                                    "status",
                                    "conclusion",
                                    "detailsUrl",
                                    "app",
                                    "startedAt",
                                    "completedAt"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "status"
                                    },
                                    "name": {
                                      "type": "string"
                                    },
                                    "state": {
                                      "type": "string"
                                    },
                                    "description": {
                                      "type": ["string", "null"]
                                    },
                                    "targetUrl": {
                                      "type": ["string", "null"]
                                    },
                                    "createdAt": {
                                      "type": ["string", "null"]
                                    }
                                  },
                                  "required": [
                                    "kind",
                                    "name",
                                    "state",
                                    "description",
                                    "targetUrl",
                                    "createdAt"
                                  ],
                                  "additionalProperties": false
                                }
                              ]
                            }
                          },
                          "diagnostics": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "sha",
                          "committedAt",
                          "aggregateState",
                          "contexts",
                          "diagnostics"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "targets": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "branch"
                              },
                              "branch": {
                                "type": "string"
                              },
                              "role": {
                                "type": "string",
                                "enum": ["primary", "default"]
                              },
                              "headSha": {
                                "type": ["string", "null"]
                              }
                            },
                            "required": ["kind", "branch", "role", "headSha"],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "checkout"
                              },
                              "path": {
                                "type": "string"
                              },
                              "branch": {
                                "type": ["string", "null"]
                              },
                              "headSha": {
                                "type": "string"
                              }
                            },
                            "required": ["kind", "path", "branch", "headSha"],
                            "additionalProperties": false
