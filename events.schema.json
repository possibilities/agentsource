      "required": ["v", "type", "event", "data"],
      "additionalProperties": false,
      "description": "Current state: replace or remove ci:<owner>:<repo>. available:false inside a projection is source unavailability, not completion."
    },
    "deliveries": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "event"
        },
        "event": {
          "type": "string",
          "const": "deliveries"
        },
        "data": {
          "type": "object",
          "properties": {
            "instanceId": {
              "type": "string",
              "minLength": 1,
              "description": "Random producer lifetime ID; changes on restart."
            },
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Always 1: this producer has no replaceable runtime."
            },
            "sequence": {
              "type": "integer",
