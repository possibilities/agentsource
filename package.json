{
  "name": "agentsource",
  "version": "0.1.0",
  "description": "A Signal Room TUI for local Git work across ~/code",
  "private": false,
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentsource": "./src/cli.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write src test scripts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@opentui/core": "^0.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "1.3.14",
    "ajv": "^8.20.0",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  }
}
